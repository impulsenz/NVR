# GAZE as a systemd service (Linux). See docs/LINUX.md.
#
#   sudo useradd --system --home /var/lib/gaze --create-home gaze
#   sudo install -m 755 target/release/nvr /usr/local/bin/gaze
#   sudo cp packaging/gaze.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now gaze
#
# Settings, accounts and recordings live in /var/lib/gaze (nvr.toml,
# nvr-data/, recordings/). Put recordings on another drive from the web
# page (Settings -> Recording & storage) and make that folder writable by
# the gaze user.
[Unit]
Description=GAZE network video recorder
After=network-online.target
Wants=network-online.target

[Service]
User=gaze
WorkingDirectory=/var/lib/gaze
ExecStart=/usr/local/bin/gaze --dir /var/lib/gaze
Restart=always
RestartSec=5
# Recording is the product: never let the system's out-of-memory killer
# pick GAZE first, and give it room for many camera connections.
OOMScoreAdjust=-500
LimitNOFILE=65536
# Keep it out of the rest of the system.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
